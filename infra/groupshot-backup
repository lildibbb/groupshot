#!/bin/sh
set -eu
set -a; . /opt/groupshot/.env; set +a
day=$(date -u +%F)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
sqlite3 /var/lib/groupshot/groupshot.sqlite ".backup '$tmp/groupshot.sqlite'"
gzip -9 "$tmp/groupshot.sqlite"
RCLONE_CONFIG_R2_TYPE=s3 RCLONE_CONFIG_R2_PROVIDER=Cloudflare \
RCLONE_CONFIG_R2_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID" RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY" \
RCLONE_CONFIG_R2_ENDPOINT="https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com" RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true \
  rclone copyto "$tmp/groupshot.sqlite.gz" "r2:${R2_BACKUP_BUCKET:-groupshot-backups}/$day.sqlite.gz"
